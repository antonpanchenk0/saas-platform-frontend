# Copy to `.env.local` for local development. Never commit real values.
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle; do not put secrets in them.
#
# Values below match the local stack from the backend repo (docker compose, nginx, `*.platform.test`).
# When the frontend runs through that stack, these values come from the backend repo's `.env`
# and `.env.local` is not needed.

# Public URL of this frontend (used for absolute links and metadata).
NEXT_PUBLIC_APP_URL=https://platform.test

# Base URL of the Django REST Framework backend (behind the backend repo's nginx).
NEXT_PUBLIC_API_BASE_URL=https://api.platform.test

# Hostnames (no scheme or port) allowed to load dev assets and HMR when the dev server is reached
# through a proxy, comma-separated. `*` matches exactly one label, so `*.platform.test` covers
# auth.platform.test and every tenant host (tenant1.platform.test, ...).
NEXT_ALLOWED_DEV_ORIGINS=platform.test,*.platform.test

# --- OpenAPI type generation (`pnpm generate:api`) ---
# Where to read the drf-spectacular OpenAPI schema from: a local file path or an http(s) URL.
# The schema is served only when the backend runs with DEBUG=True. Node must trust the backend's
# local CA for the https URL: set NODE_EXTRA_CA_CERTS to
# ../saas-platform-backend/nginx/certs/platform.test.ca.crt in your shell.
# If unset, openapi/schema.yaml (or .yml / .json) is used when it exists.
API_SCHEMA_SOURCE=https://api.platform.test/api/schema/
# API_SCHEMA_SOURCE=./openapi/schema.yaml

# --- Playwright (`pnpm test:e2e`) ---
# Base URL the E2E tests run against. The port is also used for the managed web server.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# Set to `true` to use an already running server instead of starting one.
# PLAYWRIGHT_SKIP_WEBSERVER=false

# --- ReUI (optional, only needed for paid ReUI blocks/icons) ---
# Used by the shadcn CLI when installing paid items. Not needed at runtime.
# REUI_LICENSE_KEY=
