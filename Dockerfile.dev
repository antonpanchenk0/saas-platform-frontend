# Development image with hot reload. NOT for production.
#
# Dependencies are installed into the image; the source code is bind-mounted at run time so
# edits on the host are picked up by `next dev` without rebuilding.
#
# Build (from the repository root):
#   docker build -f Dockerfile.dev -t tecca-frontend-dev .
#
# Run (bash; in PowerShell use ${PWD} instead of $(pwd); in cmd.exe use %cd%):
#   docker run --rm -it -p 3000:3000 \
#     -v "$(pwd)":/app \
#     -v /app/node_modules \
#     -v /app/.next \
#     --env-file .env.local \
#     tecca-frontend-dev
#
# Notes:
# - `-v /app/node_modules` and `-v /app/.next` keep the container's own dependencies and build
#   cache from being hidden by, or written into, your host checkout.
# - After changing package.json or pnpm-lock.yaml, rebuild the image and start a NEW container.
#   `--rm` discards the anonymous volumes, so the new container gets the fresh node_modules.
# - Drop `--env-file .env.local` if you do not have that file.
# - In Git Bash on Windows, prefix the command with `MSYS_NO_PATHCONV=1` so `/app/...` is not
#   rewritten into a Windows path.
# - If file changes are not picked up with your file-sharing setup, try adding
#   `-e WATCHPACK_POLLING=true` (it was not needed on the Docker Desktop setup this was tested on).

FROM node:22-bookworm-slim

# The pnpm version is pinned by the `packageManager` field in package.json (via Corepack).
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1 \
    HUSKY=0 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# /app/.next is pre-created so the anonymous volume mounted there is owned by `node`.
RUN corepack enable \
  && mkdir -p /app/.next \
  && chown -R node:node /app

USER node
WORKDIR /app

# Copy only the manifests first so the dependency layer is cached until they change.
COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

EXPOSE 3000

# Bind to all interfaces so the published port is reachable from the host.
CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
